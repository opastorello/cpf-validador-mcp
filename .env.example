# ── Auth ────────────────────────────────────────────────────
# Se vazio, servidor roda sem autenticação
API_TOKEN=

# ── Ambiente ────────────────────────────────────────────────
# development → /docs, /redoc, /openapi.json, /health ficam abertos sem token
# production  → apenas / fica acessível sem token
ENV=development

# ── TRT3 scraping ───────────────────────────────────────────
TRT3_BASE_URL=https://certidao.trt3.jus.br
TRT3_FORM_PATH=/certidao/feitosTrabalhistas/aba1.emissao.htm
HTTP_TIMEOUT=30
CAPTCHA_TIMEOUT=15
MAX_CAPTCHA_ATTEMPTS=20
RETRY_DELAY=1.0

# ── Workers / concorrência ───────────────────────────────────
DEFAULT_WORKERS=8
MAX_WORKERS=20
TASK_TIMEOUT=60

# ── CPF / máscara ────────────────────────────────────────────
# Máximo de wildcards (*) na parte base do CPF (posições 0-8)
# 5 wildcards = até 100.000 combinações
MAX_WILDCARDS_IN_MASK=5

# ── Rate limits (formato: N/second | N/minute | N/hour) ──────
RATE_LIMIT_FEITOS=10/minute
RATE_LIMIT_MULTIPLOS=5/minute
RATE_LIMIT_MASK=3/minute
RATE_LIMIT_VARIACOES=3/minute

# ── Captcha model ────────────────────────────────────────────
# Vazio = usa o modelo padrão em app/captcha/captcha_model.pt
CAPTCHA_MODEL_PATH=

# ── Histórico ────────────────────────────────────────────────
# Dias de retenção dos dados (LGPD). 0 = sem limite
HISTORY_RETENTION_DAYS=90
# Timezone para timestamps do histórico
APP_TIMEZONE=America/Sao_Paulo
