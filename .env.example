# ── Auth ────────────────────────────────────────────────────
# Se vazio, servidor roda sem autenticação
API_TOKEN=

# ── Ambiente ────────────────────────────────────────────────
# development → /docs, /redoc, /openapi.json, /metrics ficam abertos sem token
# production  → apenas / e /health ficam acessíveis sem token
ENV=development

# ── Fonte de consulta ────────────────────────────────────────
# Qual servico e consultado para descobrir a titularidade do CPF.
# trt3    = TRT 3a Regiao — feitos trabalhistas (MG)
# tcu     = TCU — contas julgadas irregulares (nacional)
# exemplo = fonte de exemplo, dados ficticios, nao consulta nada
SOURCE=trt3

# ── TCU ──────────────────────────────────────────────────────
TCU_BASE_URL=https://certidoes.apps.tcu.gov.br
# Teto da busca do proof-of-work (Altcha). Na pratica o contador fica < 5.000
TCU_POW_MAX_COUNTER=200000
TCU_MAX_ATTEMPTS=3

# ── TRT3 scraping ───────────────────────────────────────────
TRT3_BASE_URL=https://certidao.trt3.jus.br
TRT3_FORM_PATH=/certidao/feitosTrabalhistas/aba1.emissao.htm
HTTP_TIMEOUT=30
CAPTCHA_TIMEOUT=15
MAX_CAPTCHA_ATTEMPTS=20
RETRY_DELAY=1.0

# ── Workers / concorrência ───────────────────────────────────
DEFAULT_WORKERS=8
MAX_WORKERS=20
TASK_TIMEOUT=60

# ── CPF / máscara ────────────────────────────────────────────
# Máximo de wildcards (*) na parte base do CPF (posições 0-8)
# 5 wildcards = até 100.000 combinações
MAX_WILDCARDS_IN_MASK=5

# ── Rate limits (formato: N/second | N/minute | N/hour) ──────
RATE_LIMIT_CPF=10/minute
RATE_LIMIT_CPFS=5/minute
RATE_LIMIT_MASK=3/minute
RATE_LIMIT_VARIACOES=3/minute

# ── Captcha model ────────────────────────────────────────────
# Vazio = usa o modelo padrão em app/captcha/captcha_model.pt
CAPTCHA_MODEL_PATH=

# ── Observabilidade ──────────────────────────────────────────
# true = /metrics aberto sem token também em production
# (deixe false e configure bearer_token no Prometheus)
METRICS_PUBLIC=false

# Nivel de log do processo de consulta ao TRT3
# INFO  = resultado de cada consulta, matches e progresso do lote
# DEBUG = + cada tentativa de CAPTCHA, o texto lido pela CRNN e o nome da certidao
LOG_LEVEL=INFO
